DATABASE_URL=postgresql+asyncpg://quant:quant@db:5432/quantsaas
REDIS_URL=redis://redis:6379/0
JWT_SECRET=cambie-esta-clave
JWT_EXPIRE_MINUTES=1440
WEBHOOK_SECRET=cambie-este-secreto
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# En local, sin correo, el portal muestra el enlace de restablecimiento.
EXPOSE_RESET_TOKENS=true

# Telegram. Sin token no se envía nada. El chat id se guarda en Cuentas.
TELEGRAM_BOT_TOKEN=

# Correo de restablecimiento. Si SMTP_HOST está vacío, no se envía.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
PUBLIC_APP_URL=http://localhost:5173

# Calendario. Vacío desactiva la descarga automática.
NEWS_FEED_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
NEWS_REFRESH_HOURS=6
